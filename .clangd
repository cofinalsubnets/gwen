# the real flags live in compile_commands.json, generated by `make ccdb` (mk/tools/ccdb.py).
# a database is what clangd needs here: it runs its FALLBACK command from the file's own
# directory, so a relative -I in this file would resolve against host/ or free/ and
# miss love.h -- a fatal miss that stops the parse and makes every later name report
# undeclared. absolute directories, one entry per file, is the fix.

# rp2040 is a thumb1 cross target, and the database models the host and freestanding
# lanes only -- its flags would be the wrong ones, so it stays out and this quiets it.
If:
  PathMatch: .*port/rp2040/.*
Diagnostics:
  Suppress: '*'

---
# these two reach for a vendor SDK outside the tree (pd_api.h, emscripten.h). with
# PLAYDATE_SDK_PATH or EMSDK set, `make ccdb` puts them in the database and this stops
# mattering; without one, no flag set here could resolve the include.
If:
  PathMatch: [.*port/playdate/pdglue\.c, .*wasm/.*]
Diagnostics:
  Suppress: '*'
