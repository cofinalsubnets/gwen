vgcore.*
.gdb_history
.claude/
/out/
# downloaded, never built: limine, OVMF, package sources. outside out/ so `make clean`
# leaves it -- `make distclean` is what takes it.
/dl/
# proof/rocq/coqc build artifacts (proof/rocq/spec.v is checked by `make test_proof`).
# proof/rocq/gen.v is GENERATED and TEST-ONLY: test_gen lays it from test/spec.l and checks it in
# the same recipe, so a copy in the tree proves nothing the run does not. proof/rocq/uugen.v and
# proof/lean/uugen.lean are still checked in -- they regen + re-check in seconds and the diff is
# the drift signal. Only the compiled outputs below are ignored.
proof/rocq/gen.v
# (Benches are the exception -- regenerated manually, too slow for per-commit.)
proof/lean/*.olean
*.vo
*.vok
*.vos
*.glob
proof/rocq/.*.aux
.*.cache
# proof/rocq/extract.v EXTRACTS this (test_extract); oracle_drive.ml is the source driver
proof/rocq/normalizer.ml
proof/rocq/normalizer.mli
proof/rocq/oracle_drive
*.cmi
*.cmx
*.cmo
proof/rocq/*.o


# python bytecode caches (bench ports) -- build artifacts, never tracked
__pycache__/
*.pyc
*.core

# clangd's compilation database -- absolute paths, so it is per-machine. `make ccdb`.
compile_commands.json
.cache/clangd/

# `love seed` extracts its own source into the CWD and leaves the tree behind when the
# fixpoint fails -- untracked, and one `git add -A` from riding into the next release.
/love-*/
