vgcore.*
.gdb_history
.claude/
/out/
# downloaded, never built: limine, OVMF, package sources. outside out/ so `make clean`
# leaves it -- `make distclean` is what takes it.
/dl/
# test/proof/rocq/coqc build artifacts (test/proof/rocq/spec.v is checked by `make test_proof`).
# test/proof/rocq/gen.v is GENERATED and TEST-ONLY: test_gen lays it from test/spec.l and checks it in
# the same recipe, so a copy in the tree proves nothing the run does not. test/proof/rocq/uugen.v and
# test/proof/lean/uugen.lean are still checked in -- they regen + re-check in seconds and the diff is
# the drift signal. Only the compiled outputs below are ignored.
test/proof/rocq/gen.v
# (Benches are the exception -- regenerated manually, too slow for per-commit.)
test/proof/lean/*.olean
*.vo
*.vok
*.vos
*.glob
test/proof/rocq/.*.aux
.*.cache
# test/proof/rocq/extract.v EXTRACTS this (test_extract); oracle_drive.ml is the source driver
test/proof/rocq/normalizer.ml
test/proof/rocq/normalizer.mli
test/proof/rocq/oracle_drive
*.cmi
*.cmx
*.cmo
test/proof/rocq/*.o


# python bytecode caches (bench ports) -- build artifacts, never tracked
__pycache__/
*.pyc
*.core

# clangd's compilation database -- absolute paths, so it is per-machine. `make ccdb`.
compile_commands.json
.cache/clangd/

# `love seed` extracts its own source into the CWD and leaves the tree behind when the
# fixpoint fails -- untracked, and one `git add -A` from riding into the next release.
/love-*/

# the engineering narratives: read through and purged locally, never shipped
doc/archive/

# the two generated proof terms: test_uugen and test_uulean write them from the uu
# corpus on EVERY run, so a committed copy is 810 KB nothing ever reads
test/proof/rocq/uugen.v
test/proof/lean/uugen.lean
